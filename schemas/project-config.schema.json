{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttoolgate.dev/schemas/project-config.schema.json",
  "title": "AgentToolGate Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "port",
    "workspace",
    "hookMode",
    "openBrowser"
  ],
  "properties": {
    "projectRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "orgId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "orgId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "hookMode": {
      "type": "string",
      "enum": [
        "off",
        "dry-run",
        "live"
      ]
    },
    "openBrowser": {
      "type": "boolean"
    }
  }
}
