{
  "name": "agenttoolgate-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "proof:check": "node scripts/evaluation-proof.mjs check",
    "proof:import": "node scripts/evaluation-proof.mjs import",
    "proof:sync": "node scripts/evaluation-proof.mjs sync",
    "real-codex:check": "node scripts/real-codex-proof.mjs check",
    "real-codex:sync": "node scripts/real-codex-proof.mjs sync",
    "check": "npm run proof:check && npm run real-codex:check && tsc --noEmit --pretty false",
    "test": "npm run proof:check && npm run real-codex:check && vitest run --coverage",
    "build": "npm run proof:check && npm run real-codex:check && tsc --noEmit --pretty false && vite build",
    "preview": "vite preview",
    "e2e": "node ./scripts/run-playwright.mjs test -c playwright.config.ts",
    "playwright:install": "node ./scripts/run-playwright.mjs install --with-deps chromium"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
