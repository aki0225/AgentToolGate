POSTGRES_USER=agenttoolgate
POSTGRES_PASSWORD=agenttoolgate
POSTGRES_DB=agenttoolgate
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_MODE=local
# 本地模式需要独立审批身份时设置；至少 24 个字符，不要提交真实值。
AGT_LOCAL_REVIEWER_TOKEN=
# 所有 MCP outbound 都必须命中部署级目标 host ceiling；本地示例可设为 127.0.0.1:8081。
# 带 Secret header 的远程目标必须使用 HTTPS；仅显式列入此处的 localhost/127.0.0.1/::1 可使用 HTTP。
MCP_ALLOWED_HOSTS=
# 直接启动 backend 时可设置可信项目根；agenttoolgate up 会自动填充。
AGT_PROJECT_ROOT=
