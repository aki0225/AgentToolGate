{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aki0225/AgentToolGate/evaluation/schema/result.schema.json",
  "title": "AgentToolGate 评估结果 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "caseId",
    "suite",
    "category",
    "platform",
    "entry",
    "status",
    "expectedDecision",
    "decisionSilent",
    "signals",
    "durationMs",
    "sideEffectAttempted",
    "baselineSideEffectObserved",
    "sideEffectObserved",
    "upstreamCallsBeforeApproval",
    "secretLeakDetected",
    "selfReviewSucceeded",
    "frozenArgumentMutationSucceeded",
    "ticketReplaySucceeded",
    "offlineHighRiskAllowed",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v1"
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "caseId": {
      "$ref": "#/$defs/token"
    },
    "suite": {
      "$ref": "#/$defs/token"
    },
    "category": {
      "$ref": "#/$defs/token"
    },
    "platform": {
      "enum": [
        "windows",
        "linux"
      ]
    },
    "entry": {
      "enum": [
        "guard_core",
        "claude_hook",
        "codex_hook",
        "mcp_inbound",
        "governance"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "skipped"
      ]
    },
    "expectedDecision": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "actualDecision": {
      "$ref": "#/$defs/decision"
    },
    "riskLevel": {
      "type": "string",
      "maxLength": 32
    },
    "decisionSilent": {
      "type": "boolean"
    },
    "signals": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "sideEffectAttempted": {
      "type": "boolean"
    },
    "baselineSideEffectObserved": {
      "type": "boolean"
    },
    "sideEffectObserved": {
      "type": "boolean"
    },
    "upstreamCallsBeforeApproval": {
      "type": "integer",
      "minimum": 0
    },
    "secretLeakDetected": {
      "type": "boolean"
    },
    "selfReviewSucceeded": {
      "type": "boolean"
    },
    "frozenArgumentMutationSucceeded": {
      "type": "boolean"
    },
    "ticketReplaySucceeded": {
      "type": "boolean"
    },
    "offlineHighRiskAllowed": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "skipReason": {
      "type": "string",
      "maxLength": 4096
    },
    "failureReason": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "skipped"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "maxItems": 0
          }
        },
        "required": [
          "skipReason"
        ]
      },
      "else": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "required": [
          "actualDecision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "failureReason"
        ]
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "decision": {
      "enum": [
        "allow",
        "ask",
        "deny",
        "approval_required",
        "deny_with_ticket"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "action_observation",
            "governance_observation"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^evidence/[a-z0-9][a-z0-9._-]{0,127}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
